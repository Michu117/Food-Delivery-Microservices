# Enrutamiento por prefijo: /<servicio>/... -> http://<container-app>/...
# El prefijo se elimina gracias a la barra final en proxy_pass.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 10m;

    # Cabeceras comunes (incluye soporte de WebSocket para Socket.IO)
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location = /health {
        default_type text/plain;
        return 200 "ok\n";
    }

    location /auth/       { proxy_pass http://${AUTH_HOST}/; }
    location /restaurant/ { proxy_pass http://${RESTAURANT_HOST}/; }
    location /order/      { proxy_pass http://${ORDER_HOST}/; }
    location /delivery/   { proxy_pass http://${DELIVERY_HOST}/; }
    # Incluye el webhook de Stripe: /payment/api/payment/webhook
    location /payment/    { proxy_pass http://${PAYMENT_HOST}/; }

    location / {
        default_type text/plain;
        return 404 "SkyDish API Gateway\n";
    }
}
