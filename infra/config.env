# =====================================================================
#  Configuración de la infraestructura de SkyDish en Azure for Students
#  Edite estos valores ANTES de ejecutar los scripts.
# =====================================================================

# Región de TODOS los recursos. Debe estar entre las permitidas por su suscripción:
# Portal > Policy > Assignments > "Allowed resource deployment regions".
# (Grupo 4: canadacentral, mexicocentral, spaincentral, chilecentral, belgiumcentral)
LOCATION="canadacentral"

# Prefijo y etiquetas comunes (la política de etiquetas usa "proyecto")
PREFIX="skydish"
TAG_PROYECTO="skydish"
TAG_ENTORNO="dev"
TAG_OWNER="grupo4"

# Imágenes en GitHub Container Registry (usuario u organización EN MINÚSCULAS)
GHCR_OWNER="michu117"
IMAGE_TAG="latest"
# Solo si los paquetes de ghcr.io son privados: usuario de GitHub y un token
# (classic) con permiso read:packages. Déjelos vacíos si los paquetes son públicos.
GHCR_USER=""
GHCR_TOKEN=""

# Direccionamiento (según la propuesta)
VNET_CIDR="10.20.0.0/16"
SNET_ACA_CIDR="10.20.1.0/26"
SNET_DATA_CIDR="10.20.2.0/27"

# true = nsg-aca deniega toda salida no listada (regla 4000), como en la propuesta.
# Si el entorno de Container Apps no logra aprovisionarse, cámbielo a false.
STRICT_EGRESS="true"

# Accesos opcionales (correos de Entra ID). Déjelos vacíos para omitirlos.
TEACHER_UPN=""          # Rol Reader en la suscripción
TEAM_UPNS=""            # Separados por espacio: Contributor en rg-<prefijo>-app
NETWORK_ADMIN_UPN=""    # Network Contributor en rg-<prefijo>-net
